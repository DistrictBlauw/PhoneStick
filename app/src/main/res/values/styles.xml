<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Material 3 DayNight -->
    <style name="Theme.PhoneStick" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="android:statusBarColor">@color/md_theme_surface</item>
        <item name="android:navigationBarColor">@color/md_theme_surface</item>
        <!-- Material 3 Expressive Shapes & Dialog Overrides -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PhoneStick.MaterialAlertDialog</item>
        <item name="materialCardViewStyle">@style/Widget.PhoneStick.CardView</item>
    </style>

    <!-- Material 3 Expressive Card Style with 24dp rounded corners -->
    <style name="Widget.PhoneStick.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Material 3 Expressive Dialog Style -->
    <style name="ThemeOverlay.PhoneStick.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.PhoneStick.Dialog</item>
    </style>

    <style name="ShapeAppearance.PhoneStick.Dialog" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Circular FAB Shape Appearance -->
    <style name="ShapeAppearance.PhoneStick.CircleFab" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>
</resources>
