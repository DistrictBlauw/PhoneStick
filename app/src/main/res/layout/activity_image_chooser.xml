<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ImageChooserActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/title_activity_image_chooser"
            app:navigationIcon="?attr/homeAsUpIndicator" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            tools:visibility="visible" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/image_chooser_row" />

    <!-- Overlay backdrop for dimming background when Speed Dial is open -->
    <View
        android:id="@+id/fabOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone" />

    <!-- Speed Dial FAB Group -->
    <LinearLayout
        android:id="@+id/speedDialContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:gravity="end"
        android:orientation="vertical">

        <!-- Sub-FAB 1 (Top): Create Blank Image -->
        <LinearLayout
            android:id="@+id/layoutCreateImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_fab_label"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/action_create_blank"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnPrimary" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabCreateImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Create blank image"
                app:fabSize="mini"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.PhoneStick.CircleFab"
                app:srcCompat="@drawable/ic_add_vector" />

        </LinearLayout>

        <!-- Sub-FAB 2 (Middle): Import Image -->
        <LinearLayout
            android:id="@+id/layoutImportImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_fab_label"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/action_import_image"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnPrimary" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabImportImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Import existing image"
                app:fabSize="mini"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.PhoneStick.CircleFab"
                app:srcCompat="@drawable/ic_folder_open_vector" />

        </LinearLayout>

        <!-- Sub-FAB 3 (Bottom): Format Image(s) -->
        <LinearLayout
            android:id="@+id/layoutFormatImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_fab_label"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/action_format_images"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnPrimary" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabFormatImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Format image files"
                app:fabSize="mini"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.PhoneStick.CircleFab"
                app:srcCompat="@drawable/ic_sd_storage_vector" />

        </LinearLayout>

        <!-- Main FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Add image actions"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.PhoneStick.CircleFab"
            app:srcCompat="@drawable/ic_add_vector" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>